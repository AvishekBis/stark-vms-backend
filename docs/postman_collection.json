{
  "info": {
    "name": "Stark Group VMS API v2.1",
    "description": "Manual smoke test of the API. Requests 01-12: Assignment 1 (FR-AUTH-01, FR-V01..FR-V05). Requests 13-33: Assignment 2 (FR-V07..FR-V09, FR-DR01, FR-DR02, FR-D01, FR-D02, FR-M01, FR-M02, FR-DB01, BR-10). Requests 34-39: v2.1 hardening (optimistic locking, ADMIN user management, own password change; ADR 0023, 0024). Run top to bottom: logins store the tokens, create requests store the ids. For 24 (upload) pick any small PDF in the \"file\" form field. Set baseUrl to http://localhost:8080 or the Render URL. Demo credentials are non-real local values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminEmail",
      "value": "admin@stark.local"
    },
    {
      "key": "adminPassword",
      "value": "Admin@12345"
    },
    {
      "key": "staffEmail",
      "value": "staff@stark.local"
    },
    {
      "key": "staffPassword",
      "value": "Staff@12345"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "vehicleId",
      "value": ""
    },
    {
      "key": "vehicleNumber",
      "value": ""
    },
    {
      "key": "v2VehicleId",
      "value": ""
    },
    {
      "key": "v2VehicleId2",
      "value": ""
    },
    {
      "key": "driverId",
      "value": ""
    },
    {
      "key": "driverPhone",
      "value": ""
    },
    {
      "key": "driverLicense",
      "value": ""
    },
    {
      "key": "documentId",
      "value": ""
    },
    {
      "key": "maintenanceId",
      "value": ""
    },
    {
      "key": "vehicleVersion",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Login as ADMIN (FR-AUTH-01)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK with a bearer token', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.tokenType).to.eql('Bearer');",
              "  pm.collectionVariables.set('token', body.accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        }
      }
    },
    {
      "name": "02 Login with wrong password -> 401 generic message",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 with generic detail', () => {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().detail).to.eql('Invalid email or password.');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"wrong-password\"\n}"
        }
      }
    },
    {
      "name": "03 Current user (FR-AUTH-02)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with role', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().role).to.eql('ADMIN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "04 List vehicles (FR-V01)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 page wrapper', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.keys('content', 'page', 'size', 'totalElements', 'totalPages');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/vehicles?page=0&size=20&sort=createdAt,desc&search=",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "vehicles"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            },
            {
              "key": "sort",
              "value": "createdAt,desc"
            },
            {
              "key": "search",
              "value": ""
            }
          ]
        }
      }
    },
    {
      "name": "05 List without token -> 401 (TC-06)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 Problem Details', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/vehicles"
      }
    },
    {
      "name": "06 Create vehicle -> 201 + Location (TC-01)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Math.floor(1000 + Math.random() * 9000);",
              "pm.collectionVariables.set('vehicleNumber', 'DHK-' + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 with Location', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.response.to.have.header('Location');",
              "  pm.collectionVariables.set('vehicleId', pm.response.json().id);",
              "  pm.collectionVariables.set('vehicleVersion', pm.response.json().version);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/vehicles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicleNumber\": \"{{vehicleNumber}}\",\n  \"vehicleType\": \"CAR\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Axio\",\n  \"manufactureYear\": 2019,\n  \"color\": \"White\",\n  \"fuelType\": \"OCTANE\"\n}"
        }
      }
    },
    {
      "name": "07 Create duplicate (other formatting) -> 409 (TC-02, TC-03)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 duplicate vehicle number', () => {",
              "  pm.response.to.have.status(409);",
              "  const body = pm.response.json();",
              "  pm.expect(body.type).to.eql('https://stark-vms/errors/duplicate-vehicle-number');",
              "  pm.expect(body.errors[0].field).to.eql('vehicleNumber');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/vehicles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicleNumber\": \"{{vehicleNumber}}\",\n  \"vehicleType\": \"CAR\"\n}"
        }
      }
    },
    {
      "name": "08 Create without vehicle number -> 400 (TC-05)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 field error', () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().errors[0].field).to.eql('vehicleNumber');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/vehicles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicleType\": \"CAR\"\n}"
        }
      }
    },
    {
      "name": "09 Edit vehicle keeping its number -> 200 (TC-04)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200, model changed and version increased', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().model).to.eql('Premio');",
              "  pm.expect(pm.response.json().version).to.eql(Number(pm.collectionVariables.get('vehicleVersion')) + 1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicleNumber\": \"{{vehicleNumber}}\",\n  \"vehicleType\": \"CAR\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Premio\",\n  \"manufactureYear\": 2020,\n  \"color\": \"Black\",\n  \"fuelType\": \"OCTANE\",\n  \"version\": {{vehicleVersion}}\n}"
        }
      }
    },
    {
      "name": "10 Login as STAFF",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.collectionVariables.set('staffToken', pm.response.json().accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\"\n}"
        }
      }
    },
    {
      "name": "11 STAFF deletes vehicle -> 403 (TC-07)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{staffToken}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}"
      }
    },
    {
      "name": "12 ADMIN deletes vehicle -> 204 (FR-V04)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('204 No Content', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/vehicles/{{vehicleId}}"
      }
    },
    {
      "name": "13 Dashboard summary (FR-DB01, FR-X02)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 with all sections', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.vehicles.total).to.be.a('number');",
              "  pm.expect(body.documents.withinDays).to.eql(30);",
              "  pm.expect(body.maintenance.month).to.match(/^\\d{4}-\\d{2}$/);",
              "  pm.expect(body.expiringDocuments).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/dashboard/summary"
      }
    },
    {
      "name": "14 Search + filter vehicles on the server (FR-V08, FR-V09)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 page with currentDriver field', () => {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.totalElements).to.be.a('number');",
              "  body.content.forEach(v => { pm.expect(v.status).to.eql('ACTIVE'); pm.expect(v.vehicleType).to.eql('CAR'); });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/vehicles?search=toyota&status=ACTIVE&type=CAR&sort=vehicleNumber,asc&page=0&size=20"
      }
    },
    {
      "name": "15 Create vehicle for v2 checks",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201', () => {",
              "  pm.response.to.have.status(201);",
              "  pm.collectionVariables.set('v2VehicleId', pm.response.json().id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/vehicles",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicleNumber\": \"PM-V2-{{$timestamp}}\",\n  \"vehicleType\": \"MICROBUS\",\n  \"brand\": \"Toyota\",\n  \"model\": \"Hiace\"\n}"
        }
      }
    },
    {
      "name": "16 Create driver -> 201 (FR-DR01)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = String(Date.now()).slice(-8);",
              "pm.collectionVariables.set('driverPhone', '017' + suffix);",
              "pm.collectionVariables.set('driverLicense', 'PM-' + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 with normalized phone', () => {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.licenseStatus).to.eql('VALID');",
              "  pm.collectionVariables.set('driverId', body.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/drivers",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Postman Driver\",\n  \"phone\": \"{{driverPhone}}\",\n  \"licenseNumber\": \"{{driverLicense}}\",\n  \"licenseExpiry\": \"2030-03-31\"\n}"
        }
      }
    },
    {
      "name": "17 Duplicate driver phone (formatted) -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 duplicate-driver-phone on field phone', () => {",
              "  pm.response.to.have.status(409);",
              "  const body = pm.response.json();",
              "  pm.expect(body.type).to.eql('https://stark-vms/errors/duplicate-driver-phone');",
              "  pm.expect(body.errors[0].field).to.eql('phone');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/drivers",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Someone Else\",\n  \"phone\": \"+880{{driverPhone}}\",\n  \"licenseNumber\": \"OTHER-{{$timestamp}}\",\n  \"licenseExpiry\": \"2030-03-31\"\n}"
        }
      }
    },
    {
      "name": "18 Available drivers (assign dialog)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/drivers?available=true&search=Postman"
      }
