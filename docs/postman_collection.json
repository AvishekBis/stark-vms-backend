            {
              "key": "documentType",
              "value": "TAX_TOKEN",
              "type": "text"
            },
            {
              "key": "documentNumber",
              "value": "TT-2026-0099",
              "type": "text"
            },
            {
              "key": "issueDate",
              "value": "2025-12-01",
              "type": "text"
            },
            {
              "key": "expiryDate",
              "value": "2026-12-01",
              "type": "text"
            }
